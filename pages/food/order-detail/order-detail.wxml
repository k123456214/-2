<view class="page" wx:if="{{order}}" style="padding-bottom: 40rpx">
  <view class="status-banner">
    <text class="status-title">{{statusText}}</text>
    <text class="status-desc text-sm">下单时间: {{order.createdAtText}}</text>
  </view>

  <!-- 步骤 -->
  <view class="steps">
    <view class="step" wx:for="{{statusSteps}}" wx:key="key">
      <view class="step-icon">{{item.icon}}</view>
      <text class="text-sm">{{item.title}}</text>
    </view>
  </view>

  <!-- 配送地址 -->
  <view class="card">
    <view class="text-sm text-light">配送至</view>
    <view class="mt-10">
      <text class="text-bold">{{order.address.name}} {{order.address.phone}}</text>
    </view>
    <view class="text-sm mt-10">{{order.address.address}}</view>
  </view>

  <!-- 商户与商品 -->
  <view class="card">
    <view class="card-title text-bold" style="font-size: 30rpx">{{order.shopName}}</view>
    <view wx:for="{{order.goods}}" wx:key="id" class="order-goods">
      <view class="thumb-sm">🍽️</view>
      <view class="flex-1">
        <text>{{item.name}}</text>
        <view class="text-sm text-light">{{item.spec || '标准'}}</view>
      </view>
      <text class="text-sm">x{{item.count}}</text>
      <text class="price text-sm" style="min-width: 100rpx; text-align: right; margin-left: 16rpx">¥{{item.price}}</text>
    </view>
    <view class="divider"></view>
    <view class="flex-between" wx:if="{{order.remark}}">
      <text class="text-sm text-light">备注</text>
      <text class="text-sm">{{order.remark}}</text>
    </view>
    <view class="flex-between mt-10">
      <text class="text-sm text-light">配送费</text>
      <text class="text-sm">¥{{order.deliveryFee}}</text>
    </view>
    <view class="flex-between mt-10">
      <text class="text-bold">实付</text>
      <text class="price price-lg">¥{{order.payPrice}}</text>
    </view>
  </view>

  <!-- 日志 -->
  <view class="card">
    <view class="card-title text-lg">订单日志</view>
    <view wx:for="{{order.logsText}}" wx:key="time" class="log-item">
      <text class="log-dot"></text>
      <view class="flex-1">
        <text>{{item.text}}</text>
        <view class="text-sm text-light">{{item.timeText}}</view>
      </view>
    </view>
  </view>

  <view class="btn-row">
    <button class="btn btn-outline" bindtap="onPrint">🖨️ 打印小票</button>
    <button class="btn btn-outline" bindtap="onCallShop">联系商家</button>
    <button class="btn btn-outline" bindtap="onCallRider">联系骑手</button>
  </view>
  <view class="btn-row">
    <button class="btn btn-success" bindtap="onConfirmReceive" wx:if="{{order.status < 4}}">确认收货</button>
    <button class="btn btn-danger" bindtap="onRefund" wx:if="{{order.status >= 1 && order.status < 4}}">申请退款</button>
  </view>
</view>
