<view class="shop-page" wx:if="{{shop}}">
  <!-- 店铺信息 -->
  <view class="shop-banner">
    <view class="shop-logo">🏪</view>
    <view style="flex:1; margin-left: 20rpx">
      <text class="shop-name">{{shop.name}}</text>
      <view class="shop-sub">
        <text class="rating">★ {{shop.rating}}</text>
        <text class="text-light">月销 {{shop.sales}}</text>
      </view>
      <view class="shop-delivery text-light text-sm">{{shop.address}}</view>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="goods-layout">
    <!-- 左侧分类 -->
    <view class="cat-col">
      <view wx:for="{{categories}}" wx:key="id" 
        class="cat-item {{activeCat === idx ? 'active' : ''}}" 
        wx:for-index="idx" 
        data-idx="{{idx}}" bindtap="onCatTap">{{item.name}}</view>
    </view>
    <!-- 右侧商品 -->
    <scroll-view scroll-y class="goods-col">
      <view wx:for="{{goods}}" wx:key="id" class="goods-item" data-id="{{item.id}}" bindtap="onGoodsTap">
        <view class="goods-thumb">🍽️</view>
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <view class="goods-desc text-sm text-light">{{item.description || '美味推荐'}}</view>
          <view class="goods-spec" wx:if="{{item.attrs && item.attrs.length}}">
            <text class="text-sm text-light" wx:for="{{item.attrs}}" wx:for-item="attr" wx:key="name">
              <text wx:if="{{attr.type === 'select' || attr.type === 'multiselect'">{{attr.name}} </text>
              <text wx:if="{{attr.type === 'number'">{{attr.name}}:{{attr.min}}-{{attr.max}} </text>
            </text>
          </view>
          <view class="goods-bottom">
            <text class="price">¥{{item.price}}</text>
            <text class="text-sm text-light" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
            <view class="add-btn" catchtap="onGoodsTap" data-id="{{item.id}}">+</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部购物车 -->
  <view class="cart-bar" catchtap="toggleCart">
    <view class="cart-icon">
      🛒
      <view class="badge" wx:if="{{totalCount > 0}}">{{totalCount}}</view>
    </view>
    <view class="cart-info">
      <view class="price price-lg" wx:if="{{totalCount > 0}}">¥{{totalPrice}}</view>
      <view class="text-sm text-light" wx:else>购物车是空的</view>
      <view class="text-sm text-light" wx:if="{{cart.minOrder}}">另需配送费 ¥{{cart.deliveryFee || 0}}</view>
    </view>
    <view class="checkout-btn" wx:if="{{totalPrice >= cart.minOrder}}" catchtap="goCheckout">去结算</view>
    <view class="checkout-btn disabled" wx:else>差¥{{(cart.minOrder - totalPrice > 0 ? cart.minOrder - totalPrice : 0).toFixed(2)}}起送</view>
  </view>

  <!-- 购物车弹窗 -->
  <view class="modal-mask" wx:if="{{showCart}}" catchtap="closeModal"></view>
  <view class="cart-modal" wx:if="{{showCart}}" catchtap="closeModal">
    <view class="cart-modal-inner" catchtap="">
      <view class="cart-modal-header">
        <text class="text-bold">已选商品</text>
        <text class="text-primary" catchtap="clearCart">清空</text>
      </view>
      <view class="cart-list">
        <view wx:for="{{cart.goods}}" wx:for-index="idx" wx:key="idx" class="cart-item">
        <view class="flex-1">
          <text class="cart-item-name">{{item.name}}</text>
          <view class="text-sm text-light">{{item.spec}}</view>
        </view>
        <view class="cart-item-price">
          <text class="price text-sm">¥{{item.price}}</text>
          <view class="stepper" style="margin-left: 20rpx">
            <button catchtap="onCartGoodsCount" data-idx="{{idx}}" data-action="minus">-</button>
            <text class="count">{{item.count}}</text>
            <button catchtap="onCartGoodsCount" data-idx="{{idx}}" data-action="plus">+</button>
          </view>
        </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 属性选择弹窗 -->
  <view class="modal-mask" wx:if="{{showAttr}}" catchtap="closeModal"></view>
  <view class="attr-modal" wx:if="{{showAttr}}" catchtap="closeModal">
    <view class="attr-modal-inner" catchtap="">
      <view class="attr-modal-header">
        <text class="shop-name">{{currentGoods.name}}</text>
        <view class="price price-lg">¥{{currentGoods.price + currentAttrPrice}}</view>
      </view>
      <scroll-view scroll-y class="attr-scroll">
        <view wx:for="{{currentGoods.attrs}}" wx:for-item="attr" wx:key="name" class="attr-group">
          <view class="attr-name">
            {{attr.name}}
            <text class="text-sm text-light" wx:if="{{attr.required}}">*</text>
            <text class="text-sm text-light" wx:if="{{attr.maxSelect}}"> (可选{{attr.maxSelect}}项)</text>
            <text class="text-sm text-light" wx:if="{{attr.pricePerAddon}}"> (+¥{{attr.pricePerAddon}}/项)</text>
          </view>

          <!-- 单选 -->
          <view class="attr-options" wx:if="{{attr.type === 'select'}}">
            <view class="attr-option {{selectedAttrs[attr.name].value === opt ? 'selected' : ''}}"
              wx:for="{{attr.options}}" wx:for-item="opt" wx:key="opt"
              data-name="{{attr.name}}" data-value="{{opt}}" catchtap="onSelectAttr">{{opt}}</view>
          </view>

          <!-- 多选 -->
          <view class="attr-options" wx:if="{{attr.type === 'multiselect' && attr.options}}">
            <view class="attr-option {{selectedAttrs[attr.name].values.indexOf(opt) >= 0 ? 'selected' : ''}}"
              wx:for="{{attr.options}}" wx:for-item="opt" wx:key="opt"
              data-name="{{attr.name}}" data-value="{{opt}}" catchtap="onMultiAttrTap">{{opt}}</view>
          </view>

          <!-- 数字 -->
          <view class="attr-number" wx:if="{{attr.type === 'number'}}">
            <text class="text-sm text-light">{{attr.min}}-{{attr.max}}</text>
            <view class="stepper">
              <button catchtap="onNumberChange" data-name="{{attr.name}}" data-action="minus">-</button>
              <text class="value">{{selectedAttrs[attr.name].value}}</text>
              <button catchtap="onNumberChange" data-name="{{attr.name}}" data-action="plus">+</button>
            </view>
            <text class="text-sm text-light">步长{{attr.step || 1}}</text>
          </view>

          <!-- 文本 -->
          <view wx:if="{{attr.type === 'text'}}">
            <input class="input" placeholder="{{'输入' + attr.name}}" data-name="{{attr.name}}" bindinput="onTextInput"
              maxlength="{{attr.maxLength || 50}}" />
          </view>
        </view>
      </scroll-view>
      <view class="attr-footer">
        <view class="stepper">
          <button catchtap="onGoodsCountChange" data-action="minus">-</button>
          <text class="count">{{currentGoodsCount}}</text>
          <button catchtap="onGoodsCountChange" data-action="plus">+</button>
        </view>
        <button class="btn btn-block" catchtap="onConfirmAdd">加入购物车</button>
      </view>
    </view>
  </view>
</view>

<view class="empty" wx:else>
  <text class="empty-icon">🏪</text>
  <text>加载中...</text>
</view>
