<view class="page" wx:if="{{good}}">
  <view class="banner">
    <text class="banner-icon">📦</text>
  </view>

  <view class="card price-card">
    <view class="price-row">
      <text class="price">¥{{good.price}}</text>
      <text class="text-sm original-price" wx:if="{{good.originalPrice}}">¥{{good.originalPrice}}</text>
    </view>
    <view class="title">{{good.title}}</view>
    <view class="meta-row">
      <text class="text-sm text-light">👁️ {{good.views}} 浏览</text>
      <text class="text-sm text-light">❤️ {{good.likes}} 收藏</text>
      <text class="tag tag-success" wx:if="{{good.negotiable}}">可议价</text>
    </view>
  </view>

  <view class="card seller-card" bindtap="onChat">
    <view class="seller-avatar">👤</view>
    <view style="flex:1;">
      <view class="seller-name">{{good.seller}}</view>
      <view class="text-sm text-light">信用: 98% · {{good.location}}</view>
    </view>
    <text class="text-primary text-sm">私信 ›</text>
  </view>

  <view class="card">
    <view class="card-title">商品详情</view>
    <view class="detail-row">
      <text class="detail-label">分类</text>
      <text class="detail-value">{{good.category}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">交易地点</text>
      <text class="detail-value">{{good.location}}</text>
    </view>
    <view class="detail-row">
      <text class="detail-label">是否议价</text>
      <text class="detail-value">{{good.negotiable ? '可议价' : '不议价'}}</text>
    </view>
    <view class="divider"></view>
    <view class="desc-text">{{good.description}}</view>
  </view>

  <view style="height: 160rpx;"></view>

  <view class="action-bar">
    <view class="action-item" bindtap="onFavorite">
      <text class="action-icon">{{favorited ? '❤️' : '🤍'}}</text>
      <text class="text-sm text-light">收藏</text>
    </view>
    <view class="btn btn-outline" bindtap="onChat">私信卖家</view>
    <view class="btn btn-primary" bindtap="onBuy">立即购买</view>
  </view>
</view>

<view class="empty" wx:else>
  <text class="empty-icon">📦</text>
  <text class="text-light">加载中...</text>
</view>
