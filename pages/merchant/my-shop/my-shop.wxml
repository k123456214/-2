<view class="page" wx:if="{{shop && stats}}">
  <view class="shop-banner">
    <view class="shop-logo">🏪</view>
    <view style="flex:1; margin-left:20rpx;">
      <view class="shop-name">{{shop.name}}</view>
      <view class="text-sm text-light">评分 ★ {{shop.rating}} · 月销 {{shop.sales}}</view>
    </view>
    <view class="status-online">营业中</view>
  </view>

  <view class="card stats-card">
    <view class="stats-header">
      <text class="stats-title">今日数据</text>
    </view>
    <view class="stats-main">
      <view class="stats-item">
        <view class="stats-num">{{stats.todayOrders}}</view>
        <view class="text-sm text-light">订单数</view>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <view class="stats-num price">¥{{stats.todaySales}}</view>
        <view class="text-sm text-light">营业额</view>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <view class="stats-num">{{stats.weekSales}}</view>
        <view class="text-sm text-light">本周</view>
      </view>
    </view>
    <view class="chart">
      <view class="chart-title text-sm text-light">本周销售趋势</view>
      <view class="chart-bars">
        <view wx:for="{{stats.dailyData}}" wx:key="date" class="bar-item">
          <view class="bar-wrap">
            <view class="bar" style="height: {{item.percent}}%;"></view>
          </view>
          <text class="text-sm text-light">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">管理入口</view>
    <view class="menu-grid">
      <view class="menu-item" bindtap="onGoodsManage">
        <view class="menu-icon" style="background:#e6f7ff;color:#1890ff;">🍽️</view>
        <text class="text-sm">商品管理</text>
      </view>
      <view class="menu-item" bindtap="onOrderManage">
        <view class="menu-icon" style="background:#fff7e6;color:#fa8c16;">📋</view>
        <text class="text-sm">订单管理</text>
      </view>
      <view class="menu-item" bindtap="onShopSettings">
        <view class="menu-icon" style="background:#f6ffed;color:#52c41a;">⚙️</view>
        <text class="text-sm">店铺设置</text>
      </view>
      <view class="menu-item" bindtap="onStats">
        <view class="menu-icon" style="background:#fff1f0;color:#f5222d;">📊</view>
        <text class="text-sm">数据统计</text>
      </view>
      <view class="menu-item" bindtap="onPrinter">
        <view class="menu-icon" style="background:#f9f0ff;color:#722ed1;">🖨️</view>
        <text class="text-sm">打印机</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="card-title">今日订单</text>
      <text class="text-primary text-sm" bindtap="onOrderManage">查看全部 ›</text>
    </view>
    <view wx:for="{{todayOrders}}" wx:key="id" class="order-item" bindtap="onOrderDetail" data-id="{{item.id}}">
      <view class="order-info">
        <view class="order-id text-sm">{{item.id}}</view>
        <view class="order-user">{{item.userName}}</view>
        <view class="text-sm text-light">{{item.items}}</view>
      </view>
      <view class="order-right">
        <view class="price">¥{{item.total}}</view>
        <view wx:if="{{item.status === 1}}" class="tag tag-success">待接单</view>
        <view wx:elif="{{item.status === 2}}" class="tag tag-warning">制作中</view>
        <view wx:elif="{{item.status === 3}}" class="tag tag-danger">配送中</view>
        <view wx:else class="tag">已完成</view>
        <text class="text-sm text-light">{{item.time}}</text>
      </view>
    </view>
  </view>

  <view style="height: 40rpx;"></view>
</view>

<view class="empty" wx:else>
  <text class="empty-icon">🏪</text>
  <text class="text-light">加载中...</text>
</view>
