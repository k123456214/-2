<view class="page">
  <view class="banner">
    <view class="banner-title">🏃 发布跑腿任务</view>
    <view class="banner-sub">校园内快速解决你的小事</view>
  </view>

  <view class="card">
    <view class="form-item">
      <text class="form-label">任务类型</text>
      <view class="type-row">
        <view wx:for="{{types}}" wx:key="*this"
          class="type-chip {{form.type === item ? 'active' : ''}}"
          data-idx="{{index}}" bindtap="onTypeTap">
          {{item}}
        </view>
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">取件地址</text>
      <view class="address-row" bindtap="onPickup">
        <text class="address-icon">📍</text>
        <input class="input address-input" placeholder="点击或输入取件地址"
          data-key="pickup" value="{{form.pickup}}" bindinput="onInput" bindfocus="onPickup" />
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">送达地址</text>
      <view class="address-row" bindtap="onDelivery">
        <text class="address-icon">🏠</text>
        <input class="input address-input" placeholder="点击或输入送达地址"
          data-key="delivery" value="{{form.delivery}}" bindinput="onInput" bindfocus="onDelivery" />
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">任务描述</text>
      <textarea class="textarea" placeholder="请描述任务需求（如: 快递码、物品名称等）"
        data-key="description" value="{{form.description}}" bindinput="onInput" maxlength="200"></textarea>
    </view>
    <view class="form-item">
      <text class="form-label">悬赏费用 (¥)</text>
      <input class="input" type="digit" placeholder="请输入金额，如: 5"
        data-key="fee" value="{{form.fee}}" bindinput="onInput" />
    </view>
  </view>

  <view style="padding: 20rpx 40rpx 40rpx;">
    <button class="btn btn-primary btn-block" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '立即发布'}}
    </button>
  </view>
</view>
