<view class="page">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="id"
      class="tab-item {{activeTab === item.id ? 'active' : ''}}"
      data-id="{{item.id}}" bindtap="onTabTap">
      {{item.name}}
    </view>
  </view>

  <view class="coupon-list" wx:if="{{coupons.length > 0}}">
    <view wx:for="{{coupons}}" wx:key="id" class="coupon-card {{activeTab !== 'available' ? 'disabled' : ''}}">
      <view class="coupon-left">
        <view class="coupon-amount">
          <text wx:if="{{item.type === '满减'}}" class="symbol">¥</text>
          <text class="num">{{item.discountText}}</text>
          <text wx:if="{{item.type === '折扣'}}" class="symbol">折</text>
        </view>
        <view class="coupon-condition text-sm">满{{item.minOrder}}元可用</view>
      </view>
      <view class="coupon-right">
        <view class="coupon-name">{{item.name}}</view>
        <view class="text-sm text-light">{{item.validText}}</view>
        <view wx:if="{{activeTab === 'available'}}" class="btn btn-sm coupon-btn" data-id="{{item.id}}" bindtap="onUseTap">立即使用</view>
        <view wx:elif="{{activeTab === 'used'}}" class="text-sm text-light">已使用</view>
        <view wx:else class="text-sm text-light">已过期</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="empty-icon">🎟️</text>
    <text class="text-light">暂无优惠券</text>
  </view>
</view>
