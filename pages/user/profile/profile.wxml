<view class="page">
  <view class="header">
    <view class="user-info" wx:if="{{userInfo}}" bindtap="onEditProfile">
      <view class="avatar">
        <text class="avatar-text">{{userInfo.nickname ? userInfo.nickname[0] : '用'}}</text>
      </view>
      <view class="info-text">
        <view class="nickname">{{userInfo.nickname}}</view>
        <view class="text-sm text-light">
          <text>等级 Lv.{{userInfo.level || 1}}</text>
          <text style="margin-left:16rpx;">积分 {{userInfo.points || 0}}</text>
          <text wx:if="{{userInfo.role === 'merchant'}}" style="margin-left:16rpx;color:#fa8c16;">商户</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="user-info" wx:else bindtap="onLoginTap">
      <view class="avatar"><text class="avatar-text">?</text></view>
      <view class="info-text">
        <view class="nickname">未登录</view>
        <view class="text-sm text-light">点击登录，尽享校园服务</view>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="vip-row" wx:if="{{levelInfo}}">
      <view class="vip-tag">Lv.{{levelInfo.level}}</view>
      <text class="text-sm text-light">{{levelInfo.levelName}} · 距离下一级还需 {{levelInfo.nextLevelPoints - levelInfo.currentPoints}} 积分</text>
    </view>
  </view>

  <view class="card order-card">
    <view class="card-header">
      <text class="card-title">我的订单</text>
      <text class="text-light text-sm" bindtap="onAllOrderTap">查看全部 ›</text>
    </view>
    <view class="order-icons">
      <view class="order-item" data-status="1" bindtap="onOrderTap">
        <view class="order-icon">💰
          <view class="badge" wx:if="{{orderCount.paid > 0}}">{{orderCount.paid}}</view>
        </view>
        <text class="text-sm">待付款</text>
      </view>
      <view class="order-item" data-status="2" bindtap="onOrderTap">
        <view class="order-icon">🍳
          <view class="badge" wx:if="{{orderCount.making > 0}}">{{orderCount.making}}</view>
        </view>
        <text class="text-sm">制作中</text>
      </view>
      <view class="order-item" data-status="3" bindtap="onOrderTap">
        <view class="order-icon">🛵
          <view class="badge" wx:if="{{orderCount.delivering > 0}}">{{orderCount.delivering}}</view>
        </view>
        <text class="text-sm">配送中</text>
      </view>
      <view class="order-item" data-status="4" bindtap="onOrderTap">
        <view class="order-icon">✅</view>
        <text class="text-sm">已完成</text>
      </view>
      <view class="order-item" data-status="5" bindtap="onOrderTap">
        <view class="order-icon">↩️</view>
        <text class="text-sm">退款</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="menu-grid">
      <view class="menu-item" bindtap="onFavoriteTap">
        <view class="menu-icon">⭐</view>
        <text class="text-sm">我的收藏</text>
      </view>
      <view class="menu-item" bindtap="onCouponTap">
        <view class="menu-icon">🎟️</view>
        <text class="text-sm">优惠券</text>
      </view>
      <view class="menu-item" bindtap="onAddressTap">
        <view class="menu-icon">📍</view>
        <text class="text-sm">地址管理</text>
      </view>
      <view class="menu-item" bindtap="onApplyTap">
        <view class="menu-icon">🏪</view>
        <text class="text-sm">商户入驻</text>
      </view>
      <view class="menu-item" bindtap="onMerchantTap" wx:if="{{userInfo && userInfo.role === 'merchant'}}">
        <view class="menu-icon">📊</view>
        <text class="text-sm">我的店铺</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="list-item" data-name="客服中心" bindtap="onServiceTap">
      <text class="list-icon">💬</text>
      <text class="flex-1">客服中心</text>
      <text class="arrow">›</text>
    </view>
    <view class="list-item" data-name="帮助中心" bindtap="onServiceTap">
      <text class="list-icon">❓</text>
      <text class="flex-1">帮助中心</text>
      <text class="arrow">›</text>
    </view>
    <view class="list-item" bindtap="onSettingsTap">
      <text class="list-icon">⚙️</text>
      <text class="flex-1">设置</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view style="height: 40rpx;"></view>
</view>
