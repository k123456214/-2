<view class="page">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="id"
      class="tab-item {{activeTab === item.id ? 'active' : ''}}"
      data-id="{{item.id}}" bindtap="onTabTap">
      {{item.name}}
    </view>
  </view>

  <view wx:if="{{activeTab === 'goods' && goods.length > 0}}" class="fav-list">
    <view wx:for="{{goods}}" wx:key="id" class="card fav-card">
      <view bindtap="onGoodsTap" data-id="{{item.id}}" data-shop="{{item.shopId}}" style="display:flex;flex:1;">
        <view class="fav-thumb">🍽️</view>
        <view class="fav-info">
          <view class="fav-name">{{item.name}}</view>
          <view class="text-sm text-light">{{item.description || '美味推荐'}}</view>
          <view class="fav-price">
            <text class="price">¥{{item.price}}</text>
            <text class="text-sm text-light" wx:if="{{item.originalPrice}}"> ¥{{item.originalPrice}}</text>
          </view>
        </view>
      </view>
      <view class="fav-action">
        <view class="btn btn-outline btn-sm" bindtap="onCancel" data-id="{{item.id}}">取消</view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'shop' && shops.length > 0}}" class="fav-list">
    <view wx:for="{{shops}}" wx:key="id" class="card fav-card">
      <view bindtap="onShopTap" data-id="{{item.id}}" style="display:flex;flex:1;">
        <view class="fav-thumb">🏪</view>
        <view class="fav-info">
          <view class="fav-name">{{item.name}}</view>
          <view class="text-sm text-light">{{item.description || item.address}}</view>
          <view class="fav-price">
            <text class="rating">★ {{item.rating}}</text>
            <text class="text-sm text-light" style="margin-left:16rpx;">销量 {{item.sales}}</text>
          </view>
        </view>
      </view>
      <view class="fav-action">
        <view class="btn btn-outline btn-sm" bindtap="onCancel" data-id="{{item.id}}">取消</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{(activeTab === 'goods' && goods.length === 0) || (activeTab === 'shop' && shops.length === 0)}}">
    <text class="empty-icon">⭐</text>
    <text class="text-light">暂无收藏</text>
  </view>
</view>
